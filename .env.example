# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Spotify API credentials (optional, obtained from developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music API / MusicKit Developer Token (optional, obtained from developer.apple.com)
APPLE_MUSIC_DEVELOPER_TOKEN=
