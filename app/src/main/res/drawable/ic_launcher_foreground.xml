    <path
        android:pathData="M74,48 L74,60"
        android:strokeWidth="3.5"
        android:strokeColor="#FB7185"
        android:strokeLineCap="round" />

    <!-- Floating high-frequency dots -->
    <path
        android:fillColor="#00E5FF"
        android:pathData="M41,31 A2,2 0 1,1 41,35 A2,2 0 1,1 41,31" />
    <path
